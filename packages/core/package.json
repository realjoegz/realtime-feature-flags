{
  "name": "@rff/core",
  "version": "0.0.0",
  "private": true,
  "description": "Flag types, validation, MurmurHash3 bucketing and evaluate(). Pure functions, no I/O.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance.json": "./conformance/evaluation-cases.json"
  },
  "files": [
    "dist",
    "conformance"
  ],
  "engines": {
    "node": "24.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "conformance:write": "node test/reference/write-conformance.ts"
  }
}
