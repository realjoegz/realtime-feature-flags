{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Nest reads constructor parameter types from decorator metadata. Vitest gets the
    // same two settings through unplugin-swc, which reads this file.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src", "test", "vitest.config.ts"]
}
